# .env.example - Modèle de Configuration Firebase
# ⚠️ IMPORTANT : JAMAIS commiter de vraies clés Firebase en production
# 1. Renomme en .env.local (ajouté à .gitignore)
# 2. Remplis avec tes vraies clés Firebase
# 3. firebase-init.js les chargera automatiquement

# ===== FIREBASE CONFIG =====
# Récupère depuis: https://console.firebase.google.com → Paramètres → Config web

FIREBASE_API_KEY=AIzaSyXxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_AUTH_DOMAIN=agir-defense.firebaseapp.com
FIREBASE_PROJECT_ID=agir-defense
FIREBASE_STORAGE_BUCKET=agir-defense.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1024784205448
FIREBASE_APP_ID=1:1024784205448:web:afa82813d6ce1d9088c13d
FIREBASE_MEASUREMENT_ID=G-0R5ZZV1R5H


# ===== ANALYTICS (Optionnel) =====
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# ===== ENVIRONMENT =====
ENVIRONMENT=development
ENABLE_CAPTCHA=false
ENABLE_EMAIL=false
